FROM python:alpine

LABEL org.opencontainers.image.description=abcdesktop.pyos

RUN apk update && \
    apk upgrade --no-cache 

# update setuptools
RUN apk add --no-cache --upgrade py3-setuptools py3-pip

# or 
# RUN pip install --no-cache-dir --upgrade pip "setuptools>=84.1.0" && \
#    BUNDLED_DIR=$(python -c "import ensurepip, os; print(os.path.join(os.path.dirname(ensurepip.__file__), '_bundled'))") && \
#    rm -f "$BUNDLED_DIR"/setuptools-*.whl && \
#    pip download --no-cache-dir --no-deps "setuptools>=84.1.0" -d "$BUNDLED_DIR"

RUN apk add --no-cache --update \
 	wget \
	curl \
	cntlm \
	krb5 \
	krb5-libs \
	libgsasl \
    py3-asn1 \
	py3-virtualenv \
	py3-ldap \
    py3-python-gssapi \
	bash

SHELL ["/bin/bash", "-c"]

# GeoLite2
ENV GEOLITE_URL=https://github.com/P3TERX/GeoLite.mmdb/raw/download
RUN mkdir -p /usr/share/geolite2 && \
    wget ${GEOLITE_URL}/GeoLite2-ASN.mmdb -P /usr/share/geolite2 && \
    wget ${GEOLITE_URL}/GeoLite2-City.mmdb -P /usr/share/geolite2


# install Python dependencies from requirements.txt in the virtual environment
# these packages are needed to compile Python extensions and other dependencies
RUN apk add --no-cache --update \
	krb5-dev \
	gcc \
	musl-dev \
	python3-dev \
    krb5-dev \
	geoip-dev \
	openldap-dev

# install pyos in /var/pyos
WORKDIR /var/pyos
COPY . .

# install requirements.txt
RUN virtualenv /var/pyos

# activate the virtual environment and install Python dependencies from requirements.txt
RUN source /var/pyos/bin/activate && \
    pip install --no-cache-dir -r requirements.txt && \
    rm -rf /root/.cache/virtualenv && \
    rm -rf /var/pyos/lib/python3.14/site-packages/slapdtest/certs

# get ASNNumber database
# IPASN data files can be created by downloading MRT/RIB BGP archives from Routeviews (or similar sources), 
# and parsing them using provided scripts that tail the BGP AS-Path.
RUN source bin/activate && \
    pyasn_util_download.py --latestv46 --filename rib.bz2 && \
    pyasn_util_convert.py --single rib.bz2 ipasn_db.dat && \
    rm -f rib.bz2


# remove dev package
# should better use a builder instance
# but I can't find how to grab all new libraries
RUN apk del --no-cache \
	krb5-dev \
	gcc \
	musl-dev \
	python3-dev \
	musl-dev \
	krb5-dev \
	geoip-dev \
	openldap-dev

# update for security fix
# CVE-2026-23949 
# CVE-2026-24049
RUN source bin/activate && pip uninstall -y pip setuptools --no-cache-dir
RUN pip uninstall -y pip setuptools --no-cache-dir
# Trivy reads the vendored pip SBOMs (msgpack, urllib3, setuptools) from bom.cdx.json
RUN apk del --no-cache py3-pip py3-setuptools && \
    find / -xdev -name bom.cdx.json -delete

# dump for troubleshooting CVE
RUN apk list -I > /apk.list

# create log directory
RUN mkdir -p /var/pyos/logs 

# create an unprivileged user to run od.py
RUN addgroup -S -g 1000 pyos && \
    adduser -S -D -H -u 1000 -G pyos pyos && \
    chown -R pyos:pyos /var/pyos/logs

# CMD
COPY docker-entrypoint.sh /docker-entrypoint.sh
USER pyos
CMD [ "/docker-entrypoint.sh" ]
